DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hikvision
# Секретный токен шлюза (его знают камеры и скрипт опроса).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=change-me
# Токен панели просмотра событий. Должен отличаться от GATEWAY_TOKEN.
# Если не задан, панель отключена (шлюз при этом работает).
DASHBOARD_TOKEN=change-me-too
# Необязательно. База посещаемости FaceID (таблица public.access_logs).
# Если задана, каждый проход сотрудника дополнительно пишется туда.
# ATTENDANCE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/faceid_db
